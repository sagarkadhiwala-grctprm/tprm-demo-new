generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id               String       @id @default(cuid())
  companyName      String
  serviceType      String
  dataTypes        String       // stored as comma-separated string
  contactEmail     String
  contactName      String
  country          String
  employeeCount    String
  tier             Int          // 1, 2, or 3
  tierRationale    String       // Claude's explanation
  status           String       @default("pending_assessment")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  assessments      Assessment[]
}

model Assessment {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  questions       String   // JSON stringified array of question objects
  responses       String   // JSON stringified object: { questionId: answerText }
  scores          String   // JSON stringified object: { questionId: score 0-100 }
  overallScore    Int      // 0-100 overall risk score
  riskLevel       String   // "Low", "Medium", "High", "Critical"
  aiNarrative     String   // Full AI-generated risk summary paragraph
  keyFindings     String   // JSON stringified array of 3-5 bullet point findings
  recommendations String   // JSON stringified array of 3-5 action items
  completedAt     DateTime @default(now())
  status          String   @default("completed")
}
